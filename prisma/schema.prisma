// Prisma schema for Creative Freelancer Platform & Portfolio
// Connects to PostgreSQL (Render PostgreSQL or local)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum UserRole {
  ADMIN
  CLIENT
  FREELANCER
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ProjectCategory {
  DYNAMIC_WEB_APPS
  ECOMMERCE
  ADMIN_CRM
  BUSINESS_WEBSITES
  API_INTEGRATION
  REDESIGN_PERFORMANCE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
  CONVERTED
  ARCHIVED
}

enum ProjectStage {
  ENQUIRY
  DISCUSSION
  QUOTATION
  APPROVED
  DEVELOPMENT
  REVIEW
  DELIVERED
}

enum ChangeRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  IMPLEMENTED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ProjectRequestStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  PROPOSAL_SENT
  ACCEPTED
  DECLINED
  CANCELLED
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  APPROVED
  RELEASED
}

enum BookingStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ACTION_REQUIRED
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  name             String
  passwordHash     String?
  role             UserRole         @default(CLIENT)
  isEmailVerified  Boolean          @default(false)
  emailVerifiedAt  DateTime?
  avatar           String?
  bio              String?
  phone            String?
  company          String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relationships
  sessions         Session[]
  sentMessages     Message[]        @relation("SentMessages")
  receivedMessages Message[]        @relation("ReceivedMessages")
  notifications    Notification[]
  projectRequests  ProjectRequest[]
  bookings         Booking[]

  @@index([email])
  @@index([role])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  expiresAt  DateTime
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model VerificationToken {
  id         String    @id @default(cuid())
  identifier String
  token      String    @unique
  type       TokenType
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([identifier])
  @@index([token])
  @@index([type])
  @@index([expiresAt])
}

model PortfolioProject {
  id            String          @id @default(cuid())
  slug          String          @unique
  title         String
  tagline       String
  description   String
  category      ProjectCategory
  clientName    String?
  liveUrl       String?
  githubUrl     String?
  coverImage    String
  images        String[]
  technologies  String[]
  challenge     String?
  solution      String?
  features      String[]
  sampleMetrics String[]
  sortOrder     Int             @default(0)
  isFeatured    Boolean         @default(false)
  isPublished   Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([category])
  @@index([isPublished])
  @@index([isFeatured])
  @@index([sortOrder])
}

model Service {
  id              String           @id @default(cuid())
  slug            String           @unique
  title           String
  shortDesc       String
  fullDesc        String
  category        String
  iconName        String
  priceStartingAt Int?
  turnaroundTime  String?
  deliverables    String[]
  processSteps    String[]
  isPopular       Boolean          @default(false)
  isActive        Boolean          @default(true)
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  projectRequests ProjectRequest[]

  @@index([isActive])
  @@index([sortOrder])
}

model Lead {
  id                 String           @id @default(cuid())
  referenceNumber    String           @unique
  name               String
  email              String
  company            String?
  phone              String?
  projectType        String?
  selectedFeatures   String[]
  requirements       String?
  indicativeBudget   String?
  budgetRange        String?
  timeline           String?
  message            String
  attachments        String[]
  source             String?          @default("project_builder")
  status             LeadStatus       @default(NEW)
  internalNotes      String?
  followUpDate       DateTime?
  convertedProjectId String?
  convertedAt        DateTime?
  idempotencyKey     String?          @unique
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  projectRequests    ProjectRequest[]
  quotations         Quotation[]

  @@index([email])
  @@index([referenceNumber])
  @@index([status])
  @@index([createdAt])
  @@index([projectType])
}

model ProjectRequest {
  id               String               @id @default(cuid())
  referenceNumber  String?              @unique
  leadId           String?
  lead             Lead?                @relation(fields: [leadId], references: [id], onDelete: SetNull)
  userId           String?
  user             User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  serviceId        String?
  service          Service?             @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  title            String
  description      String
  projectType      String?
  selectedFeatures String[]
  budget           String?
  deadline         DateTime?
  status           ProjectRequestStatus @default(SUBMITTED)
  stage            ProjectStage         @default(ENQUIRY)
  attachments      String[]
  productionUrl    String?
  repositoryUrl    String?
  handoverNotes    String?
  idempotencyKey   String?              @unique
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  proposals        Proposal[]
  quotations       Quotation[]
  messages         Message[]
  invoices         Invoice[]
  milestones       Milestone[]
  stageHistory     ProjectStageHistory[]
  documents        ProjectDocument[]
  changeRequests   ChangeRequest[]

  @@index([userId])
  @@index([leadId])
  @@index([serviceId])
  @@index([status])
  @@index([stage])
  @@index([referenceNumber])
}

model ProjectStageHistory {
  id               String         @id @default(cuid())
  projectRequestId String
  projectRequest   ProjectRequest @relation(fields: [projectRequestId], references: [id], onDelete: Cascade)
  stage            ProjectStage
  actorId          String?
  actorName        String
  notes            String?
  createdAt        DateTime       @default(now())

  @@index([projectRequestId])
  @@index([stage])
  @@index([createdAt])
}

model ProjectDocument {
  id                     String         @id @default(cuid())
  projectRequestId       String
  projectRequest         ProjectRequest @relation(fields: [projectRequestId], references: [id], onDelete: Cascade)
  name                   String
  filePath               String
  fileSize               Int
  mimeType               String
  uploadedBy             String
  downloadToken          String?        @unique
  downloadTokenExpiresAt DateTime?
  createdAt              DateTime       @default(now())

  @@index([projectRequestId])
  @@index([downloadToken])
}

model ChangeRequest {
  id               String              @id @default(cuid())
  projectRequestId String
  projectRequest   ProjectRequest      @relation(fields: [projectRequestId], references: [id], onDelete: Cascade)
  title            String
  description      String
  impactAssessment String?
  additionalCost   Float?
  additionalDays   Int?
  status           ChangeRequestStatus @default(SUBMITTED)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([projectRequestId])
  @@index([status])
}

model Quotation {
  id                String              @id @default(cuid())
  quotationNumber   String              @unique
  leadId            String?
  lead              Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  projectRequestId  String?
  projectRequest    ProjectRequest?     @relation(fields: [projectRequestId], references: [id], onDelete: SetNull)
  title             String
  scope             String
  price             Float
  currency          String              @default("USD")
  validUntil        DateTime
  estimatedTimeline String
  status            QuotationStatus     @default(DRAFT)
  rejectionReason   String?
  acceptedAt        DateTime?
  rejectedAt        DateTime?
  sentAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  lineItems         QuotationLineItem[]
  auditTrail        QuotationAuditLog[]
  invoices          Invoice[]

  @@index([quotationNumber])
  @@index([leadId])
  @@index([projectRequestId])
  @@index([status])
}

model QuotationLineItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description String
  quantity    Int       @default(1)
  unitPrice   Float
  total       Float

  @@index([quotationId])
}

model QuotationAuditLog {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  action      String
  actorId     String?
  actorName   String
  notes       String?
  metadata    String?
  createdAt   DateTime  @default(now())

  @@index([quotationId])
  @@index([action])
  @@index([createdAt])
}

model Proposal {
  id               String          @id @default(cuid())
  projectRequestId String
  projectRequest   ProjectRequest  @relation(fields: [projectRequestId], references: [id], onDelete: Cascade)
  title            String
  summary          String
  totalAmount      Float
  currency         String          @default("USD")
  validUntil       DateTime?
  status           ProposalStatus  @default(DRAFT)
  terms            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  milestones       Milestone[]
  invoices         Invoice[]

  @@index([projectRequestId])
  @@index([status])
}

model Milestone {
  id                 String          @id @default(cuid())
  proposalId         String?
  proposal           Proposal?       @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  projectRequestId   String?
  projectRequest     ProjectRequest? @relation(fields: [projectRequestId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  amount             Float           @default(0)
  dueDate            DateTime?
  plannedDate        DateTime?
  progressPercentage Int             @default(0)
  order              Int             @default(0)
  status             MilestoneStatus @default(PENDING)
  completedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  invoices           Invoice[]

  @@index([proposalId])
  @@index([projectRequestId])
  @@index([status])
}

model Booking {
  id                 String        @id @default(cuid())
  userId             String?
  user               User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  name               String
  email              String
  topic              String
  notes              String?
  scheduledAt        DateTime
  durationMinutes    Int           @default(30)
  timezone           String?       @default("UTC")
  meetingUrl         String?
  status             BookingStatus @default(REQUESTED)
  cancellationReason String?
  googleEventId      String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([email])
  @@index([scheduledAt])
  @@index([status])
}

model Message {
  id               String          @id @default(cuid())
  senderId         String
  sender           User            @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId       String?
  receiver         User?           @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: SetNull)
  projectRequestId String?
  projectRequest   ProjectRequest? @relation(fields: [projectRequestId], references: [id], onDelete: Cascade)
  content          String
  attachmentUrl    String?
  attachmentName   String?
  attachmentSize   Int?
  attachmentType   String?
  isRead           Boolean         @default(false)
  readAt           DateTime?
  createdAt        DateTime        @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([projectRequestId])
  @@index([isRead])
  @@index([createdAt])
}

model Invoice {
  id               String          @id @default(cuid())
  invoiceNumber    String          @unique
  projectRequestId String?
  projectRequest   ProjectRequest? @relation(fields: [projectRequestId], references: [id], onDelete: SetNull)
  proposalId       String?
  proposal         Proposal?       @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  quotationId      String?
  quotation        Quotation?      @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  milestoneId      String?
  milestone        Milestone?      @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  userId           String?
  amount           Float           // Subtotal before tax
  taxRate          Float           @default(0) // Tax percentage (e.g. 18 for 18%)
  tax              Float           @default(0) // Calculated tax amount
  total            Float           // Grand total payable
  currency         String          @default("USD")
  status           InvoiceStatus   @default(DRAFT)
  dueDate          DateTime?
  issuedAt         DateTime?
  paidAt           DateTime?
  notes            String?
  clientName       String?
  clientEmail      String?
  clientAddress    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  lineItems        InvoiceLineItem[]
  payments         Payment[]
  auditTrail       InvoiceAuditLog[]

  @@index([invoiceNumber])
  @@index([status])
  @@index([projectRequestId])
  @@index([quotationId])
  @@index([milestoneId])
  @@index([userId])
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int      @default(1)
  unitPrice   Float
  total       Float

  @@index([invoiceId])
}

model InvoiceAuditLog {
  id         String         @id @default(cuid())
  invoiceId  String
  invoice    Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  action     String         // e.g. CREATED, ISSUED, PAYMENT_RECORDED, STATUS_CHANGED, CANCELLED, REFUNDED
  fromStatus InvoiceStatus?
  toStatus   InvoiceStatus?
  actorId    String?
  actorName  String
  notes      String?
  metadata   String?
  createdAt  DateTime       @default(now())

  @@index([invoiceId])
  @@index([action])
  @@index([createdAt])
}

model Payment {
  id             String        @id @default(cuid())
  invoiceId      String
  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount         Float
  currency       String        @default("USD")
  status         PaymentStatus @default(PENDING)
  paymentMethod  String?
  transactionRef String?       @unique
  orderId        String?
  failureReason  String?
  refundedAmount Float         @default(0)
  refundRef      String?
  metadata       String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([invoiceId])
  @@index([status])
  @@index([transactionRef])
  @@index([orderId])
}

model ProcessedWebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  provider    String   @default("razorpay")
  eventType   String
  payload     String?
  processedAt DateTime @default(now())

  @@index([eventId])
  @@index([provider])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  readAt    DateTime?
  link      String?
  metadata  String?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([type])
}
