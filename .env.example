# PostgreSQL Database Connection String
# For Render PostgreSQL, obtain the External or Internal Database URL from your Render dashboard:
# e.g., postgresql://username:password@dpg-xxxxxx-a.oregon-postgres.render.com/freelancer_db?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/freelancer_platform?schema=public"

# Application Environment
NODE_ENV="development"

# Public App URL for metadata / client redirects (Never put secrets in NEXT_PUBLIC_*)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Razorpay Test / Live Configuration
# Server-only keys (NEVER expose to client)
RAZORPAY_KEY_ID="rzp_test_yourKeyIdHere"
RAZORPAY_KEY_SECRET="yourRazorpayKeySecretHere"
RAZORPAY_WEBHOOK_SECRET="yourRazorpayWebhookSecretHere"

# Razorpay Public Key for Client Checkout (Safe for browser)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_yourKeyIdHere"
